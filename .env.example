# Amazon Bedrock Nova Sonic 2.5
NOVA_MODEL_ID=amazon.nova-2-5-sonic
AWS_REGION=us-east-1

# --- Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_VERIFIED_CALLER_ID=

# Public base URL Twilio uses to reach the Media Streams WebSocket
# (e.g. an ngrok tunnel locally, or the ALB/public DNS on AWS)
PUBLIC_BASE_URL=

# DynamoDB persistence (AWS deploy only). When BOTH are set the app uses
# DynamoDB; leave unset locally to use the in-memory store.
DUES_TABLE=
CALLS_TABLE=

# --- GA Strands OTEL telemetry (non-secret) ---
# Master switch. When true the GA bidi agent loop auto-emits OTEL spans
# (session token usage, per-response time-to-first-audio/TTFT, tool-call and
# connection-restart spans). Set to false to disable telemetry entirely.
OTEL_ENABLED=true
# Exporter: console | otlp | none. "console" (default) writes spans to stdout,
# which the ECS awslogs driver ships to CloudWatch Logs (no new infra/IAM).
OTEL_EXPORTER=console
# OTLP collector endpoint. Only used when OTEL_EXPORTER=otlp; read directly by
# the OpenTelemetry SDK. Leave blank for the console exporter.
OTEL_EXPORTER_OTLP_ENDPOINT=
